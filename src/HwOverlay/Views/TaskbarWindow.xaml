<Window x:Class="HwOverlay.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HwOverlay.Views"
        xmlns:vm="clr-namespace:HwOverlay.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="HwOverlay — barra de tarefas"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        Height="48"
        ShowActivated="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Cores por estado, vindas da paleta da janela (clara/escura conforme a barra). -->
        <Style x:Key="ArcStyle" TargetType="views:MiniArc">
            <Setter Property="Stroke" Value="{Binding Palette.Accent, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Track" Value="{Binding Palette.Track, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Thickness" Value="{Binding RingThickness, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Warning}">
                    <Setter Property="Stroke" Value="{Binding Palette.Warning, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Critical}">
                    <Setter Property="Stroke" Value="{Binding Palette.Critical, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.NoData}">
                    <Setter Property="Stroke" Value="{Binding Palette.NoData, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Palette.Text, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontSize" Value="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Warning}">
                    <Setter Property="Foreground" Value="{Binding Palette.Warning, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Critical}">
                    <Setter Property="Foreground" Value="{Binding Palette.Critical, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.NoData}">
                    <Setter Property="Foreground" Value="{Binding Palette.NoData, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Palette.Label, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontSize" Value="{Binding LabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="UnitStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Palette.Muted, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontSize" Value="{Binding LabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
    </Window.Resources>

    <!-- Margem vertical: a "pílula" não encosta nas bordas da barra. -->
    <Border Background="{Binding TaskbarBackgroundBrush}"
            CornerRadius="6"
            Margin="0,4"
            Padding="4,0"
            Cursor="SizeWE"
            ToolTip="Arraste para os lados para reposicionar · botão direito abre o menu">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Sensores e configuração..." FontWeight="SemiBold" Click="OpenSensors_Click" />
                <Separator />
                <MenuItem Header="Voltar ao overlay flutuante" Click="Floating_Click" />
                <MenuItem Header="Ocultar" Click="Hide_Click" />
                <Separator />
                <MenuItem Header="Sair" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <ItemsControl ItemsSource="{Binding Gauges}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GaugeViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="3,0" ToolTip="{Binding SensorName}">
                            <Grid Width="{Binding RingSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Height="{Binding RingSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                <views:MiniArc Fraction="{Binding Fraction}" Style="{StaticResource ArcStyle}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,1,0,0"
                                           Text="{Binding ValueText}"
                                           Style="{StaticResource ValueStyle}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="3,0,2,0">
                                <TextBlock Text="{Binding Label}"
                                           MaxWidth="64"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding UnitText}" Style="{StaticResource UnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="6,0"
                       VerticalAlignment="Center"
                       Text="HwOverlay: nenhum gauge"
                       Style="{StaticResource LabelStyle}"
                       Visibility="{Binding HasGauges, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </Border>
</Window>
