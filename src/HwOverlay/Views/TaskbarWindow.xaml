<Window x:Class="HwOverlay.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HwOverlay.Views"
        xmlns:vm="clr-namespace:HwOverlay.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        x:Name="Self"
        Title="HwOverlay — barra de tarefas"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        Height="48"
        ShowActivated="False"
        FontFamily="Segoe UI">

    <!-- Margem vertical: a "pílula" não encosta nas bordas da barra. -->
    <Border Background="{Binding BackgroundBrush}"
            CornerRadius="6"
            Margin="0,4"
            Padding="4,0"
            Cursor="SizeWE"
            ToolTip="Arraste para os lados para reposicionar · botão direito abre o menu">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Sensores e configuração..." FontWeight="SemiBold" Click="OpenSensors_Click" />
                <Separator />
                <MenuItem Header="Voltar ao overlay flutuante" Click="Floating_Click" />
                <MenuItem Header="Ocultar" Click="Hide_Click" />
                <Separator />
                <MenuItem Header="Sair" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <ItemsControl ItemsSource="{Binding Gauges}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GaugeViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="3,0" ToolTip="{Binding SensorName}">
                            <Grid Width="{Binding RingSize, ElementName=Self}" Height="{Binding RingSize, ElementName=Self}">
                                <views:MiniArc Fraction="{Binding Fraction}"
                                               Stroke="{Binding ArcBrush}"
                                               Thickness="{Binding RingThickness, ElementName=Self}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,1,0,0"
                                           Text="{Binding ValueText}"
                                           FontSize="{Binding ValueFontSize, ElementName=Self}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StateBrush}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="3,0,2,0">
                                <TextBlock Text="{Binding Label}"
                                           MaxWidth="64"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{Binding LabelFontSize, ElementName=Self}"
                                           FontWeight="SemiBold"
                                           Foreground="#C7CED8" />
                                <TextBlock Text="{Binding UnitText}"
                                           FontSize="{Binding LabelFontSize, ElementName=Self}"
                                           Foreground="#8C96A5" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="6,0"
                       VerticalAlignment="Center"
                       Foreground="#C7CED8"
                       Text="HwOverlay: nenhum gauge"
                       Visibility="{Binding HasGauges, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </Border>
</Window>
