<Window x:Class="HwOverlay.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HwOverlay.Views"
        xmlns:vm="clr-namespace:HwOverlay.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="HwOverlay — barra de tarefas"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        Height="48"
        ShowActivated="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Cores por estado, vindas da paleta da janela (clara/escura conforme a barra). -->
        <Style x:Key="ArcStyle" TargetType="views:MiniArc">
            <Setter Property="Stroke" Value="{Binding Palette.Accent, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Track" Value="{Binding Palette.Track, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Thickness" Value="{Binding RingThickness, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Warning}">
                    <Setter Property="Stroke" Value="{Binding Palette.Warning, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Critical}">
                    <Setter Property="Stroke" Value="{Binding Palette.Critical, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.NoData}">
                    <Setter Property="Stroke" Value="{Binding Palette.NoData, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Palette.Text, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontSize" Value="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Warning}">
                    <Setter Property="Foreground" Value="{Binding Palette.Warning, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.Critical}">
                    <Setter Property="Foreground" Value="{Binding Palette.Critical, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:GaugeState.NoData}">
                    <Setter Property="Foreground" Value="{Binding Palette.NoData, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Palette.Label, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontSize" Value="{Binding LabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Fundo da faixa: "pílula" sólida (padrão). Nos estilos afundados quem desenha é o InsetSurface;
             a faixa fica só com alfa mínimo para continuar recebendo o mouse. -->
        <Style x:Key="StripStyle" TargetType="Border">
            <Setter Property="Background" Value="{Binding TaskbarBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTaskbarSolidBackground}" Value="False">
                    <Setter Property="Background" Value="#01000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InsetBase" TargetType="views:InsetSurface">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Fill" Value="{Binding Palette.InsetFill, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FillOpacity" Value="{Binding DataContext.TaskbarBackgroundOpacity, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ShadowColor" Value="{Binding Palette.InsetShadow, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Highlight" Value="{Binding Palette.InsetHighlight, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <!-- Rebaixo único em volta de todos os gauges. -->
        <Style x:Key="StripInset" TargetType="views:InsetSurface" BasedOn="{StaticResource InsetBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TaskbarBackgroundStyle}" Value="Inset">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Um rebaixo por gauge. -->
        <Style x:Key="ItemInset" TargetType="views:InsetSurface" BasedOn="{StaticResource InsetBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.TaskbarBackgroundStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="InsetPerGauge">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Espaço entre gauges e, no estilo por gauge, a folga entre o rebaixo e o conteúdo. -->
        <Style x:Key="ItemStyle" TargetType="Grid">
            <Setter Property="Margin" Value="3,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.TaskbarBackgroundStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="InsetPerGauge">
                    <Setter Property="Margin" Value="2,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemContentStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.TaskbarBackgroundStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="InsetPerGauge">
                    <Setter Property="Margin" Value="3,3,5,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- Margem vertical: a "pílula" não encosta nas bordas da barra. -->
    <Border Style="{StaticResource StripStyle}"
            CornerRadius="6"
            Margin="0,4"
            Cursor="SizeWE"
            ToolTip="Arraste para os lados para reposicionar · botão direito abre o menu">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Sensores e configuração..." FontWeight="SemiBold" Click="OpenSensors_Click" />
                <Separator />
                <MenuItem Header="Voltar ao overlay flutuante" Click="Floating_Click" />
                <MenuItem Header="Ocultar" Click="Hide_Click" />
                <Separator />
                <MenuItem Header="Sair" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <views:InsetSurface Style="{StaticResource StripInset}" />

            <ItemsControl ItemsSource="{Binding Gauges}" VerticalAlignment="Center" Margin="4,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GaugeViewModel}">
                        <Grid Style="{StaticResource ItemStyle}">
                            <views:InsetSurface Style="{StaticResource ItemInset}" />
                            <StackPanel Orientation="Horizontal" Style="{StaticResource ItemContentStyle}">
                                <StackPanel.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding ValueText, Mode=OneWay}" />
                                        <Run Text="{Binding UnitText, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{Binding SensorName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel.ToolTip>
    
                                <Grid Width="{Binding RingSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Height="{Binding RingSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <views:MiniArc Fraction="{Binding Fraction}" Style="{StaticResource ArcStyle}" />
                                    <!-- Valor + unidade compacta ("42°", "7%", "5W") dentro do anel. -->
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,1,0,0"
                                               Style="{StaticResource ValueStyle}">
                                        <Run Text="{Binding ValueText, Mode=OneWay}" /><Run
                                            Text="{Binding CompactUnitText, Mode=OneWay}"
                                            FontWeight="Normal"
                                            FontSize="{Binding UnitFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock VerticalAlignment="Center"
                                           Margin="4,0,2,0"
                                           Text="{Binding TaskbarLabel}"
                                           MaxWidth="64"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource LabelStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="10,0"
                       VerticalAlignment="Center"
                       Text="HwOverlay: nenhum gauge"
                       Style="{StaticResource LabelStyle}"
                       Visibility="{Binding HasGauges, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </Border>
</Window>
