<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Só para o ícone da bandeja (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HwOverlay</RootNamespace>
    <AssemblyName>HwOverlay</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Pede elevação (UAC): sensores de temperatura de CPU/placa-mãe exigem administrador. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Roda também se a máquina tiver só o runtime 9/10 instalado. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Evita ambiguidade entre WPF e WinForms (Application, MessageBox, Brush, Color...). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
